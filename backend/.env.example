# Server Port for REST API & WebSockets
PORT=5001

# JWT Secret for User Authentication
JWT_SECRET=securebelong_jwt_secret_key_2026_super_secure

# Embedded MQTT Broker Port
MQTT_PORT=1883

# External MQTT Broker (Optional - leave empty to use built-in broker)
# EXTERNAL_MQTT_URL=mqtt://broker.hivemq.com:1883

# Database path
DB_PATH=./data/securebelong.sqlite

# Heartbeat timeout in seconds (mark ESP32 offline if no heartbeat)
HEARTBEAT_TIMEOUT_SECONDS=15
